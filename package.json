{
  "name": "devnav",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "vue-tsc --noEmit && eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "build:extension": "cd extension && npm install && npm run build && npm run package"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.19",
    "@vueuse/core": "^12.5.0",
    "dayjs": "^1.11.10",
    "lodash-es": "^4.17.21",
    "nanoid": "^5.0.9",
    "pdf-lib": "^1.17.1",
    "pinia": "^2.1.7",
    "pinyin-pro": "^3.26.0",
    "prettier": "^3.2.5",
    "qrcode": "^1.5.3",
    "toast": "^0.5.4",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.299",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.11.16",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.21.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vue-tsc": "^1.8.27"
  }
}